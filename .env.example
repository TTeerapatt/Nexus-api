# baan_laundry_api
#
# Local development — คัดลอกเป็น `.env`
#   cp .env.example .env
#
# Docker / Jenkins — ส่งผ่าน env หรือ parameter (ไม่ควร bake secret เข้า image)
#
# หมายเหตุ:
# - ถ้า password มีเครื่องหมาย # ใน DATABASE_URL ต้อง encode เป็น %23
# - ถ้ามี DATABASE_URL ระบบจะใช้ค่านี้ก่อน DB_HOST/DB_USER/DB_PASS

PORT=3001
NODE_ENV=production

# ตัวอย่างชี้ Postgres บน VPS
DATABASE_URL=postgres://postgres:CHANGE_ME%23@187.52.125.210:5432/baan_laundry
DB_HOST=187.52.125.210
DB_PORT=5432
DB_USER=postgres
DB_PASS=CHANGE_ME#
DB_NAME=baan_laundry

JWT_SECRET=change-me-to-a-long-random-string

# frontend admin origin (คั่นด้วย comma ได้)
CORS_ORIGIN=http://187.52.125.210:3000
