# nexus_api
#
# Local development — copy this file to `.env`
#   cp .env.example .env
#
# Docker / Jenkins — load runtime values from the server environment
#
# Notes:
# - Encode # in DATABASE_URL passwords as %23.
# - DATABASE_URL takes precedence over DB_HOST/DB_USER/DB_PASS when set.

PORT=3003
NODE_ENV=production

# Example PostgreSQL connection on the VPS
DATABASE_URL=postgres://postgres:CHANGE_ME%23@187.52.125.210:5432/nexus
DB_HOST=187.52.125.210
DB_PORT=5432
DB_USER=postgres
DB_PASS="CHANGE_ME#"
DB_NAME=nexus

JWT_SECRET=change-me-to-a-long-random-string

# Allowed frontend origins (comma-separated)
CORS_ORIGIN=https://trpgls.com,https://www.trpgls.com

# Jenkins (CI/CD proxy)
JENKINS_BASE_URL=http://187.52.125.210:8080
JENKINS_USER=CHANGE_ME
JENKINS_API_TOKEN=CHANGE_ME
# Shared secret for POST /nexus/api/webhook/jenkins (header: X-Jenkins-Secret)
JENKINS_WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Hostinger VPS API proxy
HOSTINGER_API_TOKEN=CHANGE_ME
